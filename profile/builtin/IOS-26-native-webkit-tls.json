{
  "name": "IOS-26-native-webkit-tls",
  "description": "Native iOS 26 app request with the WebKit/Safari TLS (20 ciphers) and native HTTP/2; captured from HelloFresh (Iterable SDK); set your app's user-agent",
  "tls": {
    "raw_client_hello": "",
    "permute": false
  },
  "http2": {
    "settings": [
      {
        "id": 2,
        "value": 0
      },
      {
        "id": 4,
        "value": 2097152
      },
      {
        "id": 3,
        "value": 100
      },
      {
        "id": 9,
        "value": 1
      }
    ],
    "connection_window_update": 10485760,
    "pseudo_order": [
      ":method",
      ":scheme",
      ":path",
      ":authority"
    ]
  },
  "headers": [
    [
      "accept",
      "*/*"
    ],
    [
      "accept-language",
      "en-US,en;q=0.9"
    ],
    [
      "accept-encoding",
      "gzip, deflate, br"
    ]
  ],
  "header_order": [
    "content-type",
    "accept",
    "authorization",
    "priority",
    "accept-language",
    "accept-encoding",
    "content-length",
    "user-agent"
  ]
}
